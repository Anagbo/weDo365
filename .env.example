# Copy this file to .env.local for local development.
# On Vercel, set the same variables in Project Settings -> Environment Variables.
# Never commit real values: .env.local is ignored by git.

# Resend API key (resend.com -> API Keys). Needs "sending access" only.
RESEND_API_KEY=

# Sender of both emails. The domain must be verified in Resend. We use the
# subdomain send.wedo365.se (EU region), so the address can be any name on it.
MAIL_FROM="WeDo365 <noreply@send.wedo365.se>"

# The owner's inbox (Loopia mailbox): new requests arrive here.
MAIL_TO_OWNER=info@wedo365.se

# Reply-To of the confirmation email the customer gets, so a reply from the
# customer lands in the owner's inbox. Falls back to MAIL_TO_OWNER if empty.
# (The owner email always has the customer as Reply-To.)
MAIL_REPLY_TO=info@wedo365.se

# Public address of the site, without a trailing slash. Used for canonical
# links, the sitemap, robots.txt and structured data. It is read when the site
# is BUILT, so change it before deploying, not after. Defaults to
# https://wedo365.se if left out.
NEXT_PUBLIC_SITE_URL=https://wedo365.se

# Set to true to show the reviews section and the Reco.se rating on the home
# page. Leave it empty until there are real reviews. Read at build time.
SHOW_REVIEWS=
